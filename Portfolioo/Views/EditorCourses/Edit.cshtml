@model Course
<h2>Edit course</h2>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-2">
        <label>Code</label><br />
        <input asp-for="Code" required pattern="[A-Z]{2,8}[0-9]{1,4}" title="Example: IT101 or DBMWEB1" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>

    <div class="mb-2">
        <label>Title</label><br />
        <input asp-for="Title" required maxlength="100" />
    </div>

    <div class="mb-2">
        <label>Description</label><br />
        <textarea asp-for="Description"></textarea>
    </div>

    <button type="submit">Save</button>
</form>
<p><a asp-action="Index">Back</a></p>